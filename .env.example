# Copy to server/.env and adjust. Never commit the real file.
NODE_ENV=development
PORT=4000

# PostgreSQL (the role must own the tables so migrations and triggers can be created)
DATABASE_URL=postgres://opencase:opencase@localhost:5432/opencase
# Used only by the integration tests. Point it at a THROWAWAY database: tests truncate tables.
TEST_DATABASE_URL=postgres://opencase:opencase@localhost:5432/opencase_test

# Bounded resources: a fixed pool plus statement/lock timeouts (overload -> 503, never an unbounded queue)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=15000

# Sessions (use a long random string, e.g. `openssl rand -hex 48`)
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=12
# Allowed browser origins (comma separated). Used for CORS and the Origin check on state-changing requests.
# List every address the React app is opened from, e.g. http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGIN=http://localhost:5173
# Set to a hop count (e.g. 1) when running behind a reverse proxy
TRUST_PROXY=false
# Defaults to true in production (HTTPS only). Set false only for plain-HTTP staging.
# COOKIE_SECURE=true
# error | warn | info | debug (tests default to error)
# LOG_LEVEL=info

# Accounts restricted to these email domains (comma separated)
COLLEGE_EMAIL_DOMAINS=college.edu
BCRYPT_ROUNDS=12

# Attachments
UPLOAD_DIR=./uploads
MAX_FILE_BYTES=5242880
MAX_FILES_PER_TICKET=5

# Workflow
DISPUTE_WINDOW_HOURS=72

# SLA deadline job
SLA_JOB_ENABLED=true
SLA_JOB_INTERVAL_MS=60000
SLA_JOB_BATCH_SIZE=25

# Public transparency dashboard
STATS_MIN_COUNT=5
STATS_CACHE_TTL_MS=60000

# Rate limits (requests per window)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_ANON_FILING_PER_HOUR=10
RATE_LIMIT_RECEIPT_PER_15MIN=60

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
